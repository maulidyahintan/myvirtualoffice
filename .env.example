# Salin file ini menjadi .env lalu isi.

# --- Claude ---
# BIARKAN KOSONG supaya Agent SDK memakai login langganan Claude kamu
# (jalankan `claude` sekali di terminal untuk login).
# Kalau diisi, pemakaian ditagih per token ke akun API kamu.
ANTHROPIC_API_KEY=

# Opsional: paksa model tertentu (kosong = default dari Claude Code)
KANTOR_MODEL=

# --- YouTube (Google Cloud Console, gratis) ---
# API key untuk riset (YouTube Data API v3)
YOUTUBE_API_KEY=
# OAuth client (tipe "Desktop app") untuk upload & analytics channel kamu
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Suara AI gratis (opsional) ---
# API key dari https://aistudio.google.com/apikey. Pakai proyek TANPA akun penagihan (billing),
# supaya tidak pernah ada biaya: kalau jatah gratis habis, Google hanya menolak dan kamu rekam sendiri.
GEMINI_API_KEY=
# Opsional: paksa model TTS tertentu (kosong = coba yang terbaru dulu)
GEMINI_TTS_MODEL=

# --- Ilustrasi AI gratis (opsional) ---
# Akun Cloudflare paket Free (jangan upgrade ke Workers Paid, supaya tidak pernah ada biaya).
# Account ID ada di dashboard Cloudflare; token: My Profile → API Tokens → template "Workers AI".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
